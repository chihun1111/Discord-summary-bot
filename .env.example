# Never commit your real token or API key.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=123456789012345678

# Explicit allowlist: normal text-channel IDs, separated by commas.
# An empty list is rejected. DMs, threads and forum posts are not collected.
INDEX_CHANNEL_IDS=234567890123456789,345678901234567890

# Optional, separate normal text channels. New messages get a bot reply thread.
# Follow-up conversation stays in the thread and is not indexed.
QUESTION_CHANNEL_IDS=

DATABASE_PATH=data/chat.db
RETENTION_DAYS=30
TIMEZONE=Asia/Seoul
SYNC_MESSAGE_LIMIT=500

# Search and indexing do not require an AI key.
# Enable ONLY after informing server members about external data processing.
ALLOW_EXTERNAL_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_DAILY_CALL_LIMIT=50
